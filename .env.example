# Application
APP_NAME=SentinelWatch
DATABASE_URL=sqlite:///./instance/sentinelwatch.db
STORAGE_DIR=storage
MAX_UPLOAD_MB=30

# Analysis defaults
PIXEL_RESOLUTION_M=10
ALERT_CONFIDENCE_THRESHOLD=0.60
MIN_COMPONENT_PIXELS=80
MODEL_PATH=models/checkpoints/siamese_unet_best.pt

# Official Copernicus Data Space Ecosystem (CDSE) provider.
# STAC metadata search is public. Create an OAuth client in CDSE before adding the
# two secret values below; never commit a real .env file.
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_REQUEST_TIMEOUT_SECONDS=120

# Monitoring. Keep scheduler false for local development and use Check Now; enable
# it only after configuring credentials and the operational Python requirements.
MONITORING_LOOKBACK_DAYS=180
MONITORING_MIN_PAIR_GAP_DAYS=20
DEFAULT_MONITORING_INTERVAL_MINUTES=1440
MAX_AOI_REQUEST_PIXELS=1024
ENABLE_MONITORING_SCHEDULER=false
SCHEDULER_POLL_SECONDS=60
ALLOW_BASELINE_WHEN_MODEL_UNAVAILABLE=true
# Optional clearly labelled offline demonstration fixtures. Run
# `python -m app.demo_seed` explicitly first; never use it for live claims.
DEMO_MODE=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MODEL_VERSION_NAME=siamese-unet-v1

# Optional SMTP. Email attempts are recorded as NOT_CONFIGURED unless both SMTP_HOST
# and SMTP_FROM are supplied. Do not put real credentials in this example file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
