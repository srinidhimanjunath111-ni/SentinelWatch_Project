# Every value here is optional; the defaults run on a laptop with no accounts or keys.

# Application
APP_NAME=SentinelWatch
DATABASE_URL=sqlite:///./instance/sentinelwatch.db
STORAGE_DIR=storage
LOG_DIR=logs
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Imagery. Earth Search is the default and Planetary Computer the failover; neither needs
# credentials. Adding the two Copernicus values makes CDSE a third provider in the chain.
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
PLANETARY_COMPUTER_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_RETRIES=3
PROVIDER_BACKOFF_SECONDS=1.5
PROVIDER_COOLDOWN_SECONDS=120
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Scene selection
MONITORING_LOOKBACK_DAYS=180
MONITORING_MIN_PAIR_GAP_DAYS=20
MIN_AOI_CLEAR_FRACTION=0.60
MIN_PAIR_VALID_FRACTION=0.30
SEASONAL_REFERENCE_WINDOW_DAYS=45
MAX_CATCH_UP_DATES=12
MAX_SCL_READS_PER_RUN=150
# The longest AOI side in 10 m pixels; 1024 is about 10 km.
MAX_AOI_REQUEST_PIXELS=1024

# Scheduler. The catalogue poll is on by default.
ENABLE_MONITORING_SCHEDULER=true
SCHEDULER_WORKERS=3
SCHEDULER_POLL_SECONDS=30
SCHEDULER_MAX_BACKOFF_SECONDS=1800
DEFAULT_MONITORING_INTERVAL_MINUTES=1440

# Findings and context
ALERT_CONFIDENCE_THRESHOLD=0.62
MAX_FINDINGS_PER_CASE=25
CONTEXT_TIMEOUT_SECONDS=12
CONTEXT_BUDGET_SECONDS=8
HEAVY_RAIN_MM_14D=100
EXTREME_RAIN_MM_14D=200

# Models. Loaded at startup when present; the spectral baseline runs and is labelled otherwise.
PRELOAD_MODELS=true
MODEL_REGISTRY_PATH=models/registry.json
# SENTINELWATCH_ML_DEVICE=cpu

# Dispatch. Without SMTP_HOST and SMTP_FROM, each message is saved as a real .eml in
# storage/outbox with status OUTBOX_SAVED, and nothing is sent. Seeded mailboxes use the
# reserved .example domain, so a live SMTP demo needs SMTP_REDIRECT_TO to reach a person.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_REDIRECT_TO=
DISPATCH_RETRIES=3

# First run
SENTINELWATCH_SEED_SITES=true
SENTINELWATCH_RESTORE_SNAPSHOT=true
SENTINELWATCH_SNAPSHOT_DIR=demo_snapshot

# Optional deployment login for mutating routes; off while empty.
SENTINELWATCH_ADMIN_PASSWORD=
SENTINELWATCH_SESSION_HOURS=12
